// The FEC link (rtl/fec_link_top.sv): data path left to right, host control below.
digraph link {
  rankdir=LR; bgcolor="white"; nodesep=0.3; ranksep=0.45; newrank=true;
  node [shape=box, style="rounded,filled", fillcolor="#f6f8fa", color="#57606a", fontname="DejaVu Sans", fontsize=10];
  edge [color="#57606a", fontname="DejaVu Sans", fontsize=9];

  src  [label="PRBS-15\nsource", fillcolor="#ddf4ff"];
  enc  [label="encoder (selected)\nK=3 programmable (7,5)\nLTE RSC K=4 (13,15)\nHamming (8,4)  |  uncoded"];
  ch   [label="channel emulator\nBSC (xorshift32)\nor fixed error patterns", fillcolor="#ffebe9"];
  dec  [label="decoder (same code)\nViterbi, register exchange\nor Hamming SEC-DED"];
  chk  [label="PRBS checker\nbits / errors", fillcolor="#ddf4ff"];
  src -> enc [label="1 bit/clk"];
  enc -> ch  [label="2-bit symbol"];
  ch  -> dec;
  dec -> chk [label="decoded bit"];

  host [label="host PC", shape=plaintext, style="", fillcolor="none"];
  uart [label="UART 8N1\nrx / tx"];
  regs [label="control and status\nregisters"];
  host -> uart [dir=both];
  uart -> regs [dir=both];
  regs -> enc [style=dashed, label="code, polynomials"];
  regs -> ch  [style=dashed, label="mode, p, pattern"];
  chk  -> regs [style=dashed, label="counters"];
  {rank=same; src; host;}
}
